:root {
  --font-size-multiplier: 1.6;
  --rg-fontstack-primary:
    Amazon Ember Display,
    Amazon Ember,
    Helvetica Neue,
    Helvetica,
    Arial,
    sans-serif;
  --rg-fontstack-display:
    Amazon Ember Display,
    Amazon Ember,
