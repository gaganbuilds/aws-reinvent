avitem-experiences" role="button" data-rigel-analytics="{&quot;name&quot;:&quot;NavItem&quot;,&quot;position&quot;:6,&quot;toggle&quot;:&quot;open&quot;}" class="rggn_8711ccd9 rggn_98b54368 rggn_70005696 rggn_007aef8b"><div class="rggn_c623175b"><span data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_007aef8b">Experiences</span></div></button></li><li class=""><a data-rg-n="BodyText" href="https://registration.awsevents.com/flow/awsevents/reinvent2026/sponsorcatalog/page/sponsors?refid=d82d4925-fa22-43c7-9105-ffbf6715ff6b" aria-expanded="false" data-rigel-analytics="{&quot;name&quot;:&quot;NavItem&quot;,&quot;position&quot;:7,&quot;toggle&quot;:null}" class="rggn_8711ccd9 rggn_98b54368 rggn_70005696 rggn_007aef8b rggn_2a7f98ee"><div class="rggn_c623175b"><span data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_007aef8b">Sponsors</span></div></a></li></ul><ul class="rggn_be2a22f9 rggn_0ec3f087"><li><a data-rg-n="BodyText" href="https://registration.awsevents.com/flow/awsevents/reinvent2026/login?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_8711ccd9 rggn_98b54368 rggn_70005696 rggn_007aef8b" data-rigel-analytics="{&quot;name&quot;:&quot;NavItem_SignIn&quot;}" style="text-decoration:none" target="_blank" rel="noopener noreferrer nofollow"><div class="rggn_c623175b">Log In</div></a></li><li><a data-rg-n="Button" href="https://registration.awsevents.com/flow/awsevents/reinvent2026/reg?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_9e423fbb rggn_1ed8cbde rggn_5962fadc rggn_e90ac70d rggn_38d8ffac rggn_f7822e54 rggn_303c672b rggn_b78e9379 rggn_1361e3f3" role="button" data-testid="create-account-button" data-rigel-analytics="{&quot;name&quot;:&quot;NavItem_CreateAccount&quot;,&quot;properties&quot;:{&quot;variant&quot;:&quot;primary&quot;}}" style="text-decoration:none" target="_blank" rel="noopener noreferrer nofollow"><span data-rg-n="UtilityText" class="rggn_8711ccd9 rggn_5e58a6df rggn_82d7eac3 rggn_f5857abf rggn_aa83ac72">Register now</span></a></li></ul></div></div><div class="rggn_84ad7149" id="globalnav-panel-plan_your_trip" aria-hidden="true"><div class="rggn_2394d901"><div class="rggn_387a1dca rggn_69015c48"><div class="rggn_f99f709a rggn_c0de2cd2 rggn_23885d27 rggn_f4965145" data-rg-n="ScrollContainer"><ul role="tablist" data-rg-list-dir="v" class="rggn_3da1576c rggn_1035c2c9"><li aria-selected="true" aria-disabled="false" data-rg-theme="orange" data-rg-mode="dark" data-rigel-analytics="{&quot;name&quot;:&quot;ListItem&quot;,&quot;properties&quot;:{&quot;button&quot;:&quot;true&quot;,&quot;disabled&quot;:false,&quot;selected&quot;:true}}" class="rggn_8ed090e4 rggn_5299a281 rggn_4059e5bf" role="tab"><span data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_275611e5">Plan your trip</span></li></ul></div></div><div class="rggn_e96e83fc"><div class="rggn_9d563434"><div class="rggn_440b5c34"></div><div><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/plan/accessibility-services/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Accessibility services</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">re:Invent is built to work for everyone. See what's available, what you can request, and how to get support before and during the event. </p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/faqs/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">FAQs</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Your questions, answered. Registration, hotels, sessions, and what to expect on the ground.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/mobile-app/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Mobile app</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b"></p></a><a data-rg-n="LinkWrapper" href="https://registration.awsevents.com/flow/awsevents/reinvent2026/venueshotel/page/venuehotel?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none" target="_blank" rel="noopener noreferrer nofollow"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Venues &amp; hotels</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Pick your hotel before the blocks sell out. Conference venues, sleeping rooms, and shuttles, all in one place.</p></a></div></div></div></div></div><div class="rggn_84ad7149" id="globalnav-panel-sessions" aria-hidden="true"><div class="rggn_2394d901"><div class="rggn_387a1dca rggn_69015c48"><div class="rggn_f99f709a rggn_c0de2cd2 rggn_23885d27 rggn_f4965145" data-rg-n="ScrollContainer"><ul role="tablist" data-rg-list-dir="v" class="rggn_3da1576c rggn_1035c2c9"><li aria-selected="true" aria-disabled="false" data-rg-theme="orange" data-rg-mode="dark" data-rigel-analytics="{&quot;name&quot;:&quot;ListItem&quot;,&quot;properties&quot;:{&quot;button&quot;:&quot;true&quot;,&quot;disabled&quot;:false,&quot;selected&quot;:true}}" class="rggn_8ed090e4 rggn_5299a281 rggn_4059e5bf" role="tab"><span data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_275611e5">Sessions</span></li></ul></div></div><div class="rggn_e96e83fc"><div class="rggn_9d563434"><div class="rggn_440b5c34"></div><div><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/sessions/curated-agendas/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Curated agendas</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Your week, your way. Multiple agendas, mapped to you. Browse curated sessions built for your role, industry, and interests. </p></a><a data-rg-n="LinkWrapper" href="https://registration.awsevents.com/flow/awsevents/reinvent2026/eventcatalog/page/eventcatalog?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none" target="_blank" rel="noopener noreferrer nofollow"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Event catalog</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Start planning your re:Invent schedule. Browse by topic, area of interest, and industry, then favorite the ones you’re interested in.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/sessions/speakers/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Featured speakers</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">See who’s speaking at AWS re:Invent 2026 and get to know some of the voices behind this year's sessions.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/sessions/keynotes/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Keynotes</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Be the first to know what’s next in cloud and AI. 2026 Keynote schedule and speaker announcements coming soon.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/sessions/how-youll-learn/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">How you'll learn</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Build Your Skills at re:Invent. Our event catalog is live with sessions designed for every skill level.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/sessions/security-focus/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Security focus</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Security depth runs deeper every day. See what's coming, and don't miss the sessions that matter.</p></a></div></div></div></div></div><div class="rggn_84ad7149" id="globalnav-panel-experiences" aria-hidden="true"><div class="rggn_2394d901"><div class="rggn_387a1dca rggn_69015c48"><div class="rggn_f99f709a rggn_c0de2cd2 rggn_23885d27 rggn_f4965145" data-rg-n="ScrollContainer"><ul role="tablist" data-rg-list-dir="v" class="rggn_3da1576c rggn_1035c2c9"><li aria-selected="true" aria-disabled="false" data-rg-theme="orange" data-rg-mode="dark" data-rigel-analytics="{&quot;name&quot;:&quot;ListItem&quot;,&quot;properties&quot;:{&quot;button&quot;:&quot;true&quot;,&quot;disabled&quot;:false,&quot;selected&quot;:true}}" class="rggn_8ed090e4 rggn_5299a281 rggn_4059e5bf" role="tab"><span data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_275611e5">Experiences</span></li></ul></div></div><div class="rggn_e96e83fc"><div class="rggn_9d563434"><div class="rggn_440b5c34"></div><div><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/experiences/collaborate-contribute?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Collaborate &amp; contribute</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Get to know the global cloud community. Connect on common challenges, hear different perspectives, and find ways to give back to the community.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/experiences/expo/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Expo</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">An Expo built for hands-on. Try it, ask the people who built it, find who can help you ship it.</p></a><a data-rg-n="LinkWrapper" href="https://aws.amazon.com/events/reinvent/experiences/uniquely-reinvent/?trk=d82d4925-fa22-43c7-9105-ffbf6715ff6b&amp;sc_channel=ps" class="rggn_28071b97 rggn_95227fab" data-rigel-analytics="{&quot;name&quot;:&quot;NavMenuCard&quot;}" style="text-decoration:none"><p data-rg-n="TitleText" class="rggn_8711ccd9 rggn_7047aa37 rggn_3267aeb9 rggn_b97b7b3b">Uniquely re:Invent</p><p data-rg-n="BodyText" class="rggn_8711ccd9 rggn_98b54368 rggn_89a878f7 rggn_02d19d07 rggn_a92652f0 rggn_007aef8b">Experiences that only work in person, with this community, during this week.</p></a></div></div></div></div></div></nav></div></div></div></div>
