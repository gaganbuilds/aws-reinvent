* {
  color-scheme: var(--rg-color-scheme, light);
}
:root,
[data-rg-mode=light] {
  --rg-color-scheme:light;
  --rg-color-background-page:#fff;
  --rg-color-background-page-inverted:#0f141a;
  --rg-color-background-object:#f3f3f7;
  --rg-color-background-object-inverted:#232b37;
