         <div data-eb-tpl-root="" data-reactroot=""><script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Quotation","text":"re:Invent is the conference we look forward to most. It brings together an unmatched group of companies and executives, with the opportunity to trade notes with some of the smartest founders in the industry.","creator":{"@type":"Person","name":"2025 Attendee, Startup founder & CEO"}}},{"@type":"ListItem","position":2,"item":{"@type":"Quotation","text":"AWS re:Invent, Amazon Web Services' annual customer conference in Las Vegas that has become something like the Super Bowl of cloud computing.","creator":{"@type":"Person","name":"The Information "}}},{"@type":"ListItem","position":3,"item":{"@type":"Quotation","text":"I've gained tangible knowledge and can actually bring knowledge back to the organisation and unlock many aspects, especially around GenAI and Agentic AI.","creator":{"@type":"Person","name":"2025 Attendee, Leadership"}}},{"@type":"ListItem","position":4,"item":{"@type":"Quotation","text":"The people; re:Invent 2025 (as always) attracted an amazing group of people, making it possible to have many impactful meetings in one trip.","creator":{"@type":"Person","name":"2025 Attendee, Financial Decision Maker"}}},{"@type":"ListItem","position":5,"item":{"@type":"Quotation","text":"The use case based sessions. Got extremely valuable insights on how different companies are tackling problems.","creator":{"@type":"Person","name":"2025 Attendee, Technical Decision Maker"}}}]}</script><div><div data-rg-lang="en" data-rg-locale="en-US" lang="en-US" dir="ltr"><div data-rg-theme="indigo" data-rg-mode="dark" data-rg-style-count="0"><section class="rgqc_e3b951bd" data-testid="quote-carousel"><div id="reinvent-is-the-conference-we-look-forward-to-most-it-brings-together-an-unmatched-group-of-companies-and-executives-with-the-opportunity-to-trade-notes-with-some-of-the-smartest-founders-in-the-industry" class="rgqc_70747978 rgqc_ddb4146d" data-rg-n="JumpLinkContainer"><div data-rg-n="GridStack" class="rgqc_92ef7532" style="--rg-gridstack-gap:var(--rg-margin-2)"><div class="rgqc_12ed26d7 rgqc_85859631 rgqc_f51223df rgqc_42499e45" data-rg-n="Grid" style="--rg-grid-gap:var(--rg-margin-3)"><div data-rg-n="Col" class="rgqc_7ca45506 rgqc_f6ca794c rgqc_05f7c623"><div class="rgqc_50d394cd"><div class="rgqc_36bc060a" data-testid="quote-carousel-container" style="transform: translate3d(0px, 0px, 0px);"><div data-testid="slide" class="rgqc_06721c80 rgqc_3d44954b" data-eb-item-id="" style="transform: translate3d(0px, 0px, 0px);"><div class="rgqc_25f89cd5 rgqc_3d44954b"><div class="rgqc_fb86f835" aria-disabled="false" data-rg-n="LargeTextQuote"><div class="rgqc_66af7f9f"></div><div class="rgqc_b60c9715"><blockquote data-rg-n="HeadingText" class="rgqc_8711ccd9 rgqc_5d220f64 rgqc_4c76e63e"><q class="rgqc_b72d9486">re:Invent is the conference we look forward to most. It brings together an unmatched group of companies and executives, with the opportunity to trade notes with some of the smartest founders in the industry.</q></blockquote><div class="rgqc_57ec5fd4"><div><p data-rg-n="UtilityText" class="rgqc_8711ccd9 rgqc_82d7eac3 rgqc_aa83ac72">2025 Attendee, Startup founder &amp; CEO</p></div></div><div class="rgqc_5073afd4 rgqc_16db2012" data-rg-n="LargeTextQuoteGradient"><div class="rgqc_30f40fb4"><div class="rgqc_0b1a90b3 rgqc_97a75433"></div><div class="rgqc_0b1a90b3 rgqc_5db4ded3"></div><div class="rgqc_0b1a90b3 rgqc_a964a7e4"></div><div class="rgqc_0b1a90b3 rgqc_47b904db"></div><div class="rgqc_0b1a90b3 rgqc_24464d86"></div></div></div></div></div></div></div><div data-testid="slide" class="rgqc_06721c80 rgqc_a3118a25" data-eb-item-id=""><div class="rgqc_25f89cd5 rgqc_a3118a25"><div class="rgqc_fb86f835" aria-disabled="true" data-rg-n="LargeTextQuote"><div class="rgqc_66af7f9f"><div class="rgqc_8daa438c" data-rg-n="Logo"><img class="rgqc_8e9ae6ea rgqc_e5ca7dd2" src="./video-poster_files/the-information-logo-lockup-white.9c89abf6aabff642bef92de4d3d8fe41e41296fe.png" alt="Missing alt text value" data-rg-n="Image"></div></div><div class="rgqc_b60c9715"><blockquote data-rg-n="HeadingText" class="rgqc_8711ccd9 rgqc_5d220f64 rgqc_4c76e63e"><q class="rgqc_b72d9486">AWS re:Invent, Amazon Web Services' annual customer conference in Las Vegas that has become something like the Super Bowl of cloud computing.</q></blockquote><div class="rgqc_57ec5fd4"><div><p data-rg-n="UtilityText" class="rgqc_8711ccd9 rgqc_82d7eac3 rgqc_aa83ac72">The Information </p></div></div><div class="rgqc_5073afd4" data-rg-n="LargeTextQuoteGradient"><div class="rgqc_30f40fb4"><div class="rgqc_0b1a90b3 rgqc_97a75433"></div><div class="rgqc_0b1a90b3 rgqc_5db4ded3"></div><div class="rgqc_0b1a90b3 rgqc_a964a7e4"></div><div class="rgqc_0b1a90b3 rgqc_47b904db"></div><div class="rgqc_0b1a90b3 rgqc_24464d86"></div></div></div></div></div></div></div><div data-testid="slide" class="rgqc_06721c80" data-eb-item-id=""><div class="rgqc_25f89cd5"><div class="rgqc_fb86f835" aria-disabled="true" data-rg-n="LargeTextQuote"><div class="rgqc_66af7f9f"></div><div class="rgqc_b60c9715"><blockquote data-rg-n="HeadingText" class="rgqc_8711ccd9 rgqc_5d220f64 rgqc_4c76e63e"><q class="rgqc_b72d9486">I've gained tangible knowledge and can actually bring knowledge back to the organisation and unlock many aspects, especially around GenAI and Agentic AI.</q></blockquote><div class="rgqc_57ec5fd4"><div><p data-rg-n="UtilityText" class="rgqc_8711ccd9 rgqc_82d7eac3 rgqc_aa83ac72">2025 Attendee, Leadership</p></div></div><div class="rgqc_5073afd4" data-rg-n="LargeTextQuoteGradient"><div class="rgqc_30f40fb4"><div class="rgqc_0b1a90b3 rgqc_97a75433"></div><div class="rgqc_0b1a90b3 rgqc_5db4ded3"></div><div class="rgqc_0b1a90b3 rgqc_a964a7e4"></div><div class="rgqc_0b1a90b3 rgqc_47b904db"></div><div class="rgqc_0b1a90b3 rgqc_24464d86"></div></div></div></div></div></div></div><div data-testid="slide" class="rgqc_06721c80" data-eb-item-id=""><div class="rgqc_25f89cd5"><div class="rgqc_fb86f835" aria-disabled="true" data-rg-n="LargeTextQuote"><div class="rgqc_66af7f9f"></div><div class="rgqc_b60c9715"><blockquote data-rg-n="HeadingText" class="rgqc_8711ccd9 rgqc_5d220f64 rgqc_4c76e63e"><q class="rgqc_b72d9486">The people; re:Invent 2025 (as always) attracted an amazing group of people, making it possible to have many impactful meetings in one trip.</q></blockquote><div class="rgqc_57ec5fd4"><div><p data-rg-n="UtilityText" class="rgqc_8711ccd9 rgqc_82d7eac3 rgqc_aa83ac72">2025 Attendee, Financial Decision Maker</p></div></div><div class="rgqc_5073afd4" data-rg-n="LargeTextQuoteGradient"><div class="rgqc_30f40fb4"><div class="rgqc_0b1a90b3 rgqc_97a75433"></div><div class="rgqc_0b1a90b3 rgqc_5db4ded3"></div><div class="rgqc_0b1a90b3 rgqc_a964a7e4"></div><div class="rgqc_0b1a90b3 rgqc_47b904db"></div><div class="rgqc_0b1a90b3 rgqc_24464d86"></div></div></div></div></div></div></div><div data-testid="slide" class="rgqc_06721c80 rgqc_4560b093" data-eb-item-id=""><div class="rgqc_25f89cd5 rgqc_4560b093"><div class="rgqc_fb86f835" aria-disabled="true" data-rg-n="LargeTextQuote"><div class="rgqc_66af7f9f"></div><div class="rgqc_b60c9715"><blockquote data-rg-n="HeadingText" class="rgqc_8711ccd9 rgqc_5d220f64 rgqc_4c76e63e"><q class="rgqc_b72d9486">The use case based sessions. Got extremely valuable insights on how different companies are tackling problems.</q></blockquote><div class="rgqc_57ec5fd4"><div><p data-rg-n="UtilityText" class="rgqc_8711ccd9 rgqc_82d7eac3 rgqc_aa83ac72">2025 Attendee, Technical Decision Maker</p></div></div><div class="rgqc_5073afd4" data-rg-n="LargeTextQuoteGradient"><div class="rgqc_30f40fb4"><div class="rgqc_0b1a90b3 rgqc_97a75433"></div><div class="rgqc_0b1a90b3 rgqc_5db4ded3"></div><div class="rgqc_0b1a90b3 rgqc_a964a7e4"></div><div class="rgqc_0b1a90b3 rgqc_47b904db"></div><div class="rgqc_0b1a90b3 rgqc_24464d86"></div></div></div></div></div></div></div></div></div><div class="rgqc_12ed26d7 rgqc_85859631 rgqc_608638c2" data-rg-n="Grid" style="--rg-grid-gap:var(--rg-margin-3)"><div data-rg-n="Col" class="rgqc_7ca45506 rgqc_f6ca794c"><div class="rgqc_9e423fbb rgqc_1ed8cbde rgqc_5962fadc rgqc_e90ac70d rgqc_079382dd" data-rg-theme="indigo" data-rg-mode="light" data-rg-n="CarouselControls"><button class="rgqc_52b298d7" disabled="" aria-label="Previous slide" data-rigel-analytics="{&quot;name&quot;:&quot;CarouselControls&quot;,&quot;properties&quot;:{&quot;direction&quot;:&quot;previous&quot;}}"><span role="presentation" class="rgqc_bd0be42c rgqc_a1b66739 rgqc_bc1a8743" data-rg-n="Icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10.7901 15.71L3.79006 8.71004C3.40006 8.32004 3.40006 7.69004 3.79006 7.30004L10.7901 0.290039L12.2001 1.70004L5.91006 7.99004L12.2001 14.28L10.7901 15.69V15.71Z" data-rg-fill="true"></path></svg></span></button><span data-rg-n="UtilityText" aria-hidden="true" class="rgqc_8711ccd9 rgqc_82d7eac3 rgqc_edb4c0cd rgqc_aa83ac72">1 / 5</span><button class="rgqc_fbe28aeb" aria-label="Next slide" data-rigel-analytics="{&quot;name&quot;:&quot;CarouselControls&quot;,&quot;properties&quot;:{&quot;direction&quot;:&quot;next&quot;}}"><span role="presentation" class="rgqc_bd0be42c rgqc_a1b66739 rgqc_bc1a8743" data-rg-n="Icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.21004 15.71L3.80004 14.3L10.09 8.01005L3.79004 1.71005L5.20004 0.300049L12.2 7.30005C12.59 7.69005 12.59 8.32005 12.2 8.71005L5.20004 15.71H5.21004Z" data-rg-fill="true"></path></svg></span></button></div></div></div></div></div></div></div></section></div></div></div></div>
