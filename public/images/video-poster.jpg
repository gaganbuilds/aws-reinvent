        <div data-eb-tpl-n="awsm-rt/rt-quote-carousel" data-eb-tpl-v="1.1.0" data-eb-ce="" data-eb-c-scope="9e6cbd88-e63b-42aa-a289-7e56a25d9317" data-eb-d-scope="INLINE" data-eb-locale="en-US" data-eb-159a8cec="" data-eb-ssr-ce="" data-eb-tpl-ns="awsmRT" data-eb-hydrated="done">
         <script type="application/json">{"data":{"items":[{"fields":{"patternBoolean":"true","itemHeading":"re:Invent is the conference we look forward to most. It brings together an unmatched group of companies and executives, with the opportunity to trade notes with some of the smartest founders in the industry.","itemOption":"2025 Attendee, Startup founder & CEO"},"metadata":{"tags":[]}},{"fields":{"itemMediaAltText2":"Missing alt text value","itemHeading":"AWS re:Invent, Amazon Web Services' annual customer conference in Las Vegas that has become something like the Super Bowl of cloud computing.","patternBoolean":"true","itemMediaURL2":"https://d1.awsstatic.com/onedam/marketing-channels/website/aws/en_US/events/approved/summit_sponsors_white/the-information-logo-lockup-white.9c89abf6aabff642bef92de4d3d8fe41e41296fe.png","itemOption":"The Information "},"metadata":{"tags":[]}},{"fields":{"patternBoolean":"true","itemHeading":"I've gained tangible knowledge and can actually bring knowledge back to the organisation and unlock many aspects, especially around GenAI and Agentic AI.","itemOption":"2025 Attendee, Leadership"},"metadata":{"tags":[]}},{"fields":{"patternBoolean":"true","itemHeading":"The people; re:Invent 2025 (as always) attracted an amazing group of people, making it possible to have many impactful meetings in one trip.","itemOption":"2025 Attendee, Financial Decision Maker"},"metadata":{"tags":[]}},{"fields":{"patternBoolean":"true","itemHeading":"The use case based sessions. Got extremely valuable insights on how different companies are tackling problems.","itemOption":"2025 Attendee, Technical Decision Maker"},"metadata":{"tags":[]}},{"fields":{"itemCTAURL":"mock","patternBoolean2":"true","itemMediaURL2":"mock","itemOption":"mock","itemMediaAltText2":"mock","id":"ams#quotecarousel#pattern-data","itemHeading":"mock","itemTextNoLoc":"mock"},"metadata":{"tags":[{"name":"pattern-data","description":"Default pattern data","id":"ams#quotecarousel#pattern-