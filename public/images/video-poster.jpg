      <script type="application/json">{"data":{"items":[{"fields":{"globalNav":"{\"dark\":false,\"isSearchDisabled\":true,\"isChinaSite\":false,\"showFeedback\":false,\"logoURL\":\"RIV-navlogo-v2.f95e8a33c69deb053e79828b0806c68944922fd7.png\",\"logoSrc\":\"https://d1.awsstatic.com/onedam/marketing-channels/website/aws/en_US/events/approved/reinvent26/RIV-navlogo-v2.f95e8a33c69deb053e79828b0806c68944922fd7.png\",\"logoAlt\":\"AWS\",\"logoLink\":\"https://aws.amazon.com/events/reinvent\",\"searchURL\":\"api\",\"createAccountButtonLabel\":\"Register now\",\"createAccountButtonURL\":\"https://registration.awsevents.com/flow/awsevents/reinvent2026/reg\",\"signinLabel\":\"Log In\",\"signinURL\":\"https://registration.awsevents.com/flow/awsevents/reinvent2026/login\",\"schemaVersion\":1,\"items\":[{\"name\":\"Plan your trip\",\"linkURL\":\"\",\"subNav\":[{\"name\":\"Plan your trip\",\"linkURL\":\"\",\"columns\":[{\"type\":\"ListColumn\",\"items\":[{\"heading\":\"Accessibility services\",\"subheading\":\"re:Invent is built to work for everyone. See what\\u0027s available, what you can request, and how to get support before and during the event. \",\"linkURL\":\"https://aws.amazon.com/events/reinvent/plan/accessibility-services/\"},{\"heading\":\"FAQs\",\"subheading\":\"Your questions, answered. Registration, hotels, sessions, and what to expect on the ground.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/faqs/\"},{\"heading\":\"Mobile app\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/mobile-app/\"},{\"heading\":\"Venues \\u0026 hotels\",\"subheading\":\"Pick your hotel before the blocks sell out. Conference venues, sleeping rooms, and shuttles, all in one place.\",\"linkURL\":\"https://registration.awsevents.com/flow/awsevents/reinvent2026/venueshotel/page/venuehotel\"}]}]}]},{\"name\":\"Pricing\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/pricing/\"},{\"name\":\"Approval toolkit\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/approval-toolkit/\"},{\"name\":\"Agenda\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/agenda/\"},{\"name\":\"Sessions\",\"linkURL\":\"\",\"subNav\":[{\"name\":\"Sessions\",\"linkURL\":\"\",\"columns\":[{\"type\":\"ListColumn\",\"items\":[{\"heading\":\"Curated agendas\",\"subheading\":\"Your week, your way. Multiple agendas, mapped to you. Browse curated sessions built for your role, industry, and interests. \",\"linkURL\":\"https://aws.amazon.com/events/reinvent/sessions/curated-agendas/\"},{\"heading\":\"Event catalog\",\"subheading\":\"Start planning your re:Invent schedule. Browse by topic, area of interest, and industry, then favorite the ones you’re interested in.\",\"linkURL\":\"https://registration.awsevents.com/flow/awsevents/reinvent2026/eventcatalog/page/eventcatalog\"},{\"heading\":\"Featured speakers\",\"subheading\":\"See who’s speaking at AWS re:Invent 2026 and get to know some of the voices behind this year\\u0027s sessions.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/sessions/speakers/\"},{\"heading\":\"Keynotes\",\"subheading\":\"Be the first to know what’s next in cloud and AI. 2026 Keynote schedule and speaker announcements coming soon.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/sessions/keynotes/\"},{\"heading\":\"How you\\u0027ll learn\",\"subheading\":\"Build Your Skills at re:Invent. Our event catalog is live with sessions designed for every skill level.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/sessions/how-youll-learn/\"},{\"heading\":\"Security focus\",\"subheading\":\"Security depth runs deeper every day. See what\\u0027s coming, and don\\u0027t miss the sessions that matter.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/sessions/security-focus/\"}]}]}]},{\"name\":\"Experiences\",\"linkURL\":\"\",\"subNav\":[{\"name\":\"Experiences\",\"linkURL\":\"\",\"columns\":[{\"type\":\"ListColumn\",\"items\":[{\"heading\":\"Collaborate \\u0026 contribute\",\"subheading\":\"Get to know the global cloud community. Connect on common challenges, hear different perspectives, and find ways to give back to the community.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/experiences/collaborate-contribute\"},{\"heading\":\"Expo\",\"subheading\":\"An Expo built for hands-on. Try it, ask the people who built it, find who can help you ship it.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/experiences/expo/\"},{\"heading\":\"Uniquely re:Invent\",\"subheading\":\"Experiences that only work in person, with this community, during this week.\",\"linkURL\":\"https://aws.amazon.com/events/reinvent/experiences/uniquely-reinvent/\"}]}]}]},{\"name\":\"Sponsors\",\"linkURL\":\"https://registration.awsevents.com/flow/awsevents/reinvent2026/sponsorcatalog/page/sponsors\"}],\"utilityItems\":[],\"availableLanguages\":[]}"},"metadata":{"tags":[]}}]},"metadata":{"auth":{},"testAttributes":{}},"context":{"page":{"pageUrl":"https://aws.amazon.com/events/reinvent/"},"contentType":"page","environment":{"stage":"prod","region":"us-west-2"},"sdkVersion":"2.0.27"},"refMap":{"manifest.js":"00121e6291","rt-global-nav.css":"11ab9b54cc","rt-global-nav.js":"73d30c8216","rt-global-nav.rtl.css":"ca68777add","rt-global-nav.css.js":"0959bccb8e","rt-global-nav.rtl.css.js":"c8c8737fe0"},"settings":{"templateMappings":{"globalNav":"globalNav"}}}</script>
