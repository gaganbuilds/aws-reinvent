  --rg-color-code-window:#f6f6f9;
  --rg-shadow-gray-elevation-1:1px 1px 20px rgba(0,0,0,.1);
  --rg-shadow-gray-elevation-2:1px 1px 24px rgba(0,0,0,.25);
  --rg-shadow-gradient-fuchsia:linear-gradient(
      
      123deg,
      #d14600 0%,
      #c300e0 50%,
      #6842ff 100%);
