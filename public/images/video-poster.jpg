    sans-serif;
  --rg-fontstack-mono:
    Amazon Ember Mono,
    Consolas,
    Andale Mono WT,
    Andale Mono,
    Lucida Console,
    Lucida Sans Typewriter,
    DejaVu Sans Mono,
    Bitstream Vera Sans Mono,
    Liberation Mono,
    Nimbus Mono L,
    Monaco,
    Courier New,
    Courier,
    monospace;
}
